# Copy to .env.local for local development. Never commit real values.

# Claude partner (server-side only; never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# Set automatically on Vercel when "Protection Bypass for Automation" is enabled.
# Locally, only needed to run Playwright or scripts against a protected preview.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Playwright / scripts target (defaults to http://localhost:3000)
BASE_URL=
