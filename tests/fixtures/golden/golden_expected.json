{
  "spec_version": "METHODS v1 draft: Option B (verdict p = max of MK-HR and OLS-AR(1)), Hamed-Rao factor capped at 1",
  "conventions": {
    "series": "yearly series, float64 (cast float32 npz values to float64 before testing)",
    "time_axis": "calendar years; slopes are per year (per decade = x10)",
    "alpha": 0.05,
    "min_valid_yearly_values": 10,
    "mk": "two-sided, normal approximation with continuity correction and tie-corrected Var(S); tau = S / (n(n-1)/2)",
    "hamed_rao": "Var(S) multiplied by n/n*_s = 1 + 2/(n(n-1)(n-2)) * sum_k (n-k)(n-k-1)(n-k-2) rho_k over ALL lags 1..n-1 whose rho_k is outside +-1.96/sqrt(n); rho = biased ACF (denominator n) of the ranks of y - Sen_slope*index (average ranks for ties). FACTOR CAPPED AT 1. 'uncapped_reference' is kept only to cross-check against pymannkendall.",
    "sen_ci": "Gilbert 1987: C = 1.96*sqrt(Var(S)); lower = pair-slope at 1-indexed rank (N-C)/2, upper at rank (N+C)/2+1, N = n(n-1)/2, linear interpolation. Headline CI uses the capped Hamed-Rao Var(S).",
    "ols_ar1": "r1 = sum(e_t e_{t+1}) / sum(e_t^2) of OLS residuals; n_eff = n(1-r1)/(1+r1), n_eff = n if r1 <= 0; SE_adj = SE_ols * sqrt((n-2)/(n_eff-2)); t on n_eff-2 df (Santer et al. 2000). Undefined if n_eff <= 2.",
    "verdict_p": "OPTION B: p_used = max(p_MK-HR, p_OLS-AR1); if OLS-AR(1) undefined, p_used = p_MK-HR",
    "tiers": "on p_used: <0.05 confirmed; <0.20 not_proven_yet; else no_case; <10 valid yearly values -> too_short",
    "badges": "tests_disagree = exactly one of {p_MK-HR<0.05, p_OLS-AR1<0.05}; autocorrelated = OLS residual r1 > 0.3",
    "years_needed": "b = OLS slope, sigma = sqrt(SSE/(n-2)), phi = max(r1,0); smallest n*>=n with |b|/SE(n*) >= t_{0.975,n_eff(n*)-2} (~50% detection odds); displayed iff tier == not_proven_yet and p_used<0.5 and extra years <= 50.",
    "magnitude": "total_change_sen = Sen slope x (last_year - first_year); pct_of_mean_per_decade = 100*10*Sen/mean"
  },
  "tolerances": {
    "integers": "exact",
    "slopes_means_CI_ends_n_eff_r1": "rel 1e-9 (abs 1e-12)",
    "p_values_z_t_q": "rel 1e-7",
    "booleans_tiers_years_needed_ids": "exact"
  },
