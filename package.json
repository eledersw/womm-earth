{
  "name": "womm-earth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"next dev\" \"python -m uvicorn api.index:app --reload --host 127.0.0.1 --port 8000\"",
    "dev:web": "next dev",
    "dev:api": "python -m uvicorn api.index:app --reload --host 127.0.0.1 --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && next build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:types": "python scripts/gen_openapi.py && openapi-typescript api/openapi.json -o lib/api-types.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@observablehq/plot": "^0.6.19",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.3",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-globe.gl": "^2.38.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "minimatch": "^11.0.8",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22"
  }
}
